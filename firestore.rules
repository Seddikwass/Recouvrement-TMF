rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function principal() {
      return request.auth != null && email() == 'wassim.khalfalli@tmf.com.tn';
    }
    function role() {
      return get(/databases/$(database)/documents/roles/$(email())).data.role;
    }
    function inscrit() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(email()))
        && role() in ['user', 'admin'];
    }
    function connecte() { return principal() || inscrit(); }
    function admin() { return principal() || (inscrit() && role() == 'admin'); }
    match /roles/{e} {
      allow read: if admin() || (request.auth != null && e == email());
      allow create: if admin() || (request.auth != null && e == email()
        && email().matches('.*@tmf[.]com[.]tn$')
        && request.resource.data.role == 'user');
      allow update, delete: if admin();
    }
    match /clients/{id}   { allow read: if connecte(); allow write: if admin(); }
    match /invoices/{id}  { allow read: if connecte(); allow write: if admin(); }
    match /relances/{id}  { allow read: if connecte(); allow write: if admin(); }
    match /clotures/{id}  { allow read: if connecte(); allow write: if admin(); }
    match /config/{id}    { allow read: if connecte(); allow write: if admin(); }
  }
}
