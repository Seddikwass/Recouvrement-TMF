rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function principal() {
      return request.auth != null && email() == 'wassim.khalfalli@tmf.com.tn';
    }
    function inscrit() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(email()));
    }
    function connecte() { return principal() || inscrit(); }
    function admin() {
      return principal() || (inscrit()
        && get(/databases/$(database)/documents/roles/$(email())).data.role == 'admin');
    }
    match /roles/{e}      { allow read: if admin() || (request.auth != null && e == email()); allow write: if admin(); }
    match /clients/{id}   { allow read, create: if connecte(); allow update, delete: if admin(); }
    match /invoices/{id}  { allow read, create: if connecte(); allow update, delete: if admin(); }
    match /relances/{id}  { allow read, create: if connecte(); allow update, delete: if admin(); }
    match /clotures/{id}  { allow read: if connecte(); allow write: if admin(); }
    match /config/{id}    { allow read: if connecte(); allow write: if admin(); }
  }
}
